{
  "name": "@aliste-sdk/observability",
  "version": "1.2.1",
  "description": "Production-grade observability SDK — tracing (OpenTelemetry) and metrics (Prometheus)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "observability",
    "opentelemetry",
    "otel",
    "prometheus",
    "metrics",
    "tracing",
    "aliste"
  ],
  "author": "Aliste Technologies <tech@alistetechnologies.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alistetechnologies/aliste-sdk.git",
    "directory": "packages/observability"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.57.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.57.0",
    "@opentelemetry/resources": "1.30.0",
    "@opentelemetry/sdk-node": "0.57.0",
    "@opentelemetry/sdk-trace-base": "1.30.0",
    "@opentelemetry/semantic-conventions": "1.28.0",
    "prom-client": "15.1.3"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "express": "^4.21.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
